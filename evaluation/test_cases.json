    "vision": [{"label": "bottle", "confidence": 0.90, "spatial_sector": "LEFT"}],
    "gesture": {"gesture": "POINT_LEFT", "direction": "LEFT", "confidence": 0.9},
    "env": {"obstacle_distance": 2.0, "human_distance": 1.5, "emergency_stop": false},
    "expected": {"status": "VALID", "target": "bottle", "action": "pick", "safety": "SAFE"}
  },
